---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Layout title="blog.nbergeron.dev">
  <div class="wrap">
    <section class="hero">
      <p class="eyebrow">nwber@blog:~$</p>
      <h1>cloud infrastructure, kubernetes &amp; tinkering</h1>
      <p class="lede">
        Notes on running Kubernetes at home, cheap cloud compute, and other things I break while learning.
      </p>
    </section>

    <section>
      <h2 class="section-head">Posts</h2>
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a class="post-item" href={`/blog/${post.id}`} data-post-slug={post.id}>
              <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
              <span class="title">{post.data.title}</span>
              {post.data.description && <p class="desc">{post.data.description}</p>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Layout>

<script is:inline>
  document.querySelectorAll('[data-post-slug]').forEach((postLink) => {
    postLink.addEventListener('click', () => {
      window.posthog?.capture('blog_post_selected', {
        post_slug: postLink.dataset.postSlug,
      });
    });
  });
</script>
