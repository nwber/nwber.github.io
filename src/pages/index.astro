---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmtDate = (d: Date) => d.toISOString().slice(0, 10);
---

<Layout title="blog.nbergeron.dev">
  <h1 class="sr-only">blog.nbergeron.dev</h1>

  <header>
    <pre class="banner" aria-hidden="true">┌────────────────────────────────────────────────────┐
│                                                    │
│   <span class="prompt">nwber@blog:~$</span> whoami                             │
│   nwber                                            │
│                                                    │
│   <span class="prompt">nwber@blog:~$</span> cat /etc/motd                      │
│   cloud infrastructure | kubernetes | tinkering    │
│                                                    │
│   <span class="prompt">nwber@blog:~$</span> ls -1 ~/posts                      │
│                                                    │
└────────────────────────────────────────────────────┘</pre>
  </header>

  <main>
    <p class="eyebrow">~/posts</p>
    <div is-="separator" direction-="x"></div>
    <ul class="post-list">
      {posts.map((post) => (
        <li box-="square">
          <p class="post-meta">
            <span is-="badge">{fmtDate(post.data.pubDate)}</span>
          </p>
          <a class="post-title" href={`/blog/${post.id}`} data-post-slug={post.id}>
            <span class="prompt">~/blog/$ </span>{post.data.title}
          </a>
          {post.data.description && <p class="post-desc">{post.data.description}</p>}
        </li>
      ))}
    </ul>
  </main>

  <footer>
    <div class="divider"></div>
    <p class="eyebrow">nwber@blog:~$ <span class="cursor"></span></p>
  </footer>
</Layout>

<script is:inline>
  document.querySelectorAll('[data-post-slug]').forEach((postLink) => {
    postLink.addEventListener('click', () => {
      window.posthog?.capture('blog_post_selected', {
        post_slug: postLink.dataset.postSlug,
      });
    });
  });
</script>
